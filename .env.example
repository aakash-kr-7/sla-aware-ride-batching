# Copy to .env and supply local values. Never commit the populated file.
# Compose reads .env; export the same values before starting Spring Boot.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ride_batching
DB_USER=postgres
DB_PASSWORD=
JWT_SECRET=

# Optional local-profile bootstrap (only creates an admin in an empty account table).
LOCAL_ADMIN_ENABLED=false
LOCAL_ADMIN_USERNAME=
LOCAL_ADMIN_PASSWORD=
